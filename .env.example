# Copy this file to .env and fill in your values. The .env file is gitignored.

# Port the dev server listens on.
# Avoid Windows reserved ranges (e.g. 8042-8141, which includes 8080).
PORT=9000

# Anthropic API key — enables the AI assist panel (Summarize / Improve).
# Leave unset to run the editor without AI (the buttons report "not configured").
ANTHROPIC_API_KEY=

# Optional: Redis connection string for cross-instance scaling / the gated scaling test.
# REDIS_URL=redis://localhost:6379
