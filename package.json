{
  "name": "duet",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative code editor with a hand-written RGA CRDT",
  "author": "riyarana25",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riyarana25/Duet.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "esbuild src/web/main.ts --bundle --minify --format=iife --target=es2020 --outfile=public/bundle.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start:server": "node dist/server/main.js",
    "dev": "npm run build && npm run build:web && npm run start:server",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^16.18.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "fast-check": "^3.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "acorn": "^8.17.0",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.11.1",
    "redis": "^4.7.1",
    "ws": "^8.21.0"
  }
}
